# E2M Backend Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret - change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# API Tokens
REPLICATE_API_TOKEN=your-replicate-api-token
HF_API_TOKEN=your-huggingface-api-token

# CORS Origins - comma-separated list of allowed frontend URLs
# For production, set this to your Vercel frontend URL
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:3000

# Database (Railway will set DATABASE_URL automatically)
# DB_PATH=./e2m.db
